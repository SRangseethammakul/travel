# MongoDB connection string (dev: local mongod or Docker `mongo:9.0.8`)
MONGODB_URI=mongodb://127.0.0.1:27017/travel-planner
PORT=4000
# development | test | production — the `mock-user` cookie only works outside production
NODE_ENV=development
# At least 32 random characters each, e.g. `openssl rand -base64 48`
SESSION_SECRET=change-me-change-me-change-me-change-me
FILE_URL_SECRET=change-me-change-me-change-me-change-me
# Frontend origin allowed by CORS (with credentials)
CORS_ORIGIN=http://localhost:3000
# Public base URL the browser uses for this API (OAuth redirect URIs, signed file URLs).
# = the web origin: Next rewrites /api/* to this backend (docs/adr/0001).
PUBLIC_API_URL=http://localhost:3000
# How many reverse proxies in front of the backend append the client IP to X-Forwarded-For.
# Next does NOT count (it passes the header through). 0 = none (local). Behind one load balancer: 1.
TRUST_PROXY=0
# Where uploaded Documents are stored in dev
UPLOAD_DIR=.data/uploads
# OAuth — leave empty to turn a provider off.
# Redirect URI to register: ${PUBLIC_API_URL}/api/auth/google/callback and /api/auth/line/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
