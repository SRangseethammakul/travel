# Read by docker-compose.yml. Copy to .env and change for anything beyond local use.
BACKEND_NODE_ENV=development
# At least 32 random characters each, e.g. `openssl rand -base64 48`
SESSION_SECRET=
FILE_URL_SECRET=
CORS_ORIGIN=http://localhost:3000
# = the web origin: Next rewrites /api/* to the backend (docs/adr/0001)
PUBLIC_API_URL=http://localhost:3000
# How many reverse proxies in front of the backend append the client IP to X-Forwarded-For.
# Next does NOT count (it passes the header through). 0 = none (local). Behind one load balancer: 1.
TRUST_PROXY=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Frontend → backend URL, used only by the Next server (fetch + /api rewrites).
# docker-compose sets http://backend:4000 itself; for `npm run dev` in frontend/
# the default is http://localhost:4000 (set it in frontend/.env.local to change).
# BACKEND_URL=http://localhost:4000
